# Copia este archivo a .env (no se versiona) y ajusta los valores.
# Sin credenciales reales: estos son valores de desarrollo local.

# PostgreSQL
POSTGRES_DB=observatorio
POSTGRES_USER=observatorio
POSTGRES_PASSWORD=cambia-esta-clave-local
DATABASE_URL=postgresql://observatorio:cambia-esta-clave-local@postgres:5432/observatorio

# Kafka (nombre de servicio Docker, no localhost)
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_DEMO=sismos.demo
KAFKA_TOPIC_LIVE=sismos.live
KAFKA_TOPIC_REPLAY=sismos.replay
KAFKA_CONSUMER_GROUP=observatorio-consumer

# Productor
# demo | live | replay
PRODUCER_MODE=demo
# Copias extra idénticas del evento demo (demuestra idempotencia). 0 = solo un mensaje.
DEMO_DUPLICATES=1
# Reproducción (PRODUCER_MODE=replay): selección del histórico descargado, ordenada por fecha
REPLAY_START=2025-01-01T00:00:00Z
REPLAY_COUNT=10
REPLAY_MIN_MAG=5.0
REPLAY_INTERVAL_SECONDS=2
REPLAY_INJECT_CASES=true
POLL_SECONDS=60
USGS_FEED_URL=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/all_day.geojson
HTTP_TIMEOUT_SECONDS=15

# API
# Modo por defecto de /api/eventos (demo | live | replay). `demo` para la verificación vertical;
# cámbialo a `live` cuando el productor funcione en modo live (PRODUCER_MODE=live).
API_DEFAULT_MODE=demo
CORS_ORIGINS=http://localhost:4200,https://TU-SITIO.netlify.app
API_MAX_FEATURES=5000
STALE_AFTER_SECONDS=300

# Rutas dentro del contenedor
COUNTRIES_GEOJSON=/app/data/paises.geojson
RAW_DATA_DIR=/app/data/raw
# Días que se conservan los GeoJSON originales de USGS (ver data/README.md)
RAW_RETENTION_DAYS=14
LOG_LEVEL=INFO

# ngrok: el authtoken se configura en el agente local (ngrok config add-authtoken ...), nunca aquí ni en Git.
